@inproceedings{won2026sieve,
  title     = {Sieve and Sage: Efficient Distraction Filtering for Reliable RALM Abstention},
  author    = {Won, Jongbin and An, Sung Geun and Lee, Jay-Yoon},
  booktitle = {Findings of the Association for Computational Linguistics: EMNLP 2026},
  year      = {2026},
  url       = {https://openreview.net/forum?id=jqrg278fKi},
  abstract  = {Retrieval-Augmented Language Models should abstain when the retrieved evidence cannot support a reliable response. We decompose retrieval failures into an unanswerable state, where the required evidence is absent, and a distracted state, where relevant evidence is mixed with conflicting, negated, or adversarial information. A lightweight module (Sieve) screens retrieved document sets for distracting evidence before invoking a costly LLM (Sage) for grounded generation and abstention. Across general and high-stakes expert domains the framework improves system accuracy by up to 69.4%p and Macro-F1 by 55.2%p over one-stage baselines, with up to a 1.99x speedup.},
  selected  = {true}
}
